{
  "expo": {
    "name": "Woyofal Map",
    "slug": "woyofal-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "woyofalmap",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0F766E",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sn.woyofalmap.app"
    },
    "android": {
      "package": "sn.woyofalmap.app",
      "adaptiveIcon": { "backgroundColor": "#0F766E" }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": false },
    "extra": {
      "apiUrl": "http://localhost:4000",
      "googleClientIdIos": "",
      "googleClientIdAndroid": "",
      "googleClientIdWeb": ""
    }
  }
}
