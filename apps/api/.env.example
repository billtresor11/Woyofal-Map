# --- Base de données -------------------------------------------------------
# SQLite en développement (un simple fichier), PostgreSQL en production.
DATABASE_URL="file:./dev.db"

# --- Serveur ---------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# Origines autorisées à appeler l'API, séparées par des virgules.
# À renseigner uniquement si le front est hébergé sur un autre domaine.
WEB_ORIGIN="http://localhost:5173"

# --- Connexion Google ------------------------------------------------------
# OBLIGATOIRE EN PRODUCTION. Sans lui, tous les foyers seraient accessibles
# sans connexion : le serveur refuse alors de démarrer, avec un message clair.
#
# En développement (NODE_ENV != production), le laisser vide reste possible :
# l'application s'ouvre sans compte, ce qui évite d'avoir à configurer Google
# pour lancer le projet.
#
# Il se crée en 3 minutes : voir docs/AUTHENTIFICATION.md
GOOGLE_CLIENT_ID=""

# Démonstration publique assumée, SANS aucune connexion, en production.
# À n'utiliser qu'en connaissance de cause : tout le monde voit tous les foyers.
# ALLOW_ANONYMOUS=true

# Secret qui signe les cookies de session. OBLIGATOIRE en production.
# Générez-le avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
