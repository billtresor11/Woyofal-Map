# --- Base de données -------------------------------------------------------
# SQLite en développement (un simple fichier), PostgreSQL en production.
DATABASE_URL="file:./dev.db"

# --- Serveur ---------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# Origines autorisées à appeler l'API, séparées par des virgules.
# À renseigner uniquement si le front est hébergé sur un autre domaine.
WEB_ORIGIN="http://localhost:5173"

# --- Connexion Google (facultatif en développement) ------------------------
# Tant que GOOGLE_CLIENT_ID est vide, l'application fonctionne SANS compte :
# pratique pour développer et pour la démonstration hors ligne.
# Dès qu'il est renseigné, la connexion Google devient obligatoire.
# Il se crée en 3 minutes : voir docs/AUTHENTIFICATION.md
GOOGLE_CLIENT_ID=""

# Secret qui signe les cookies de session. OBLIGATOIRE en production.
# Générez-le avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
